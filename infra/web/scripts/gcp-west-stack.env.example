# GCP us-west1 (Oregon) mirror stack — merge into the orchestrator /etc/moq-web.env
# IPs stay empty until terraform apply + install. STACK_ENABLED=0 keeps the picker stubbed.
GCP_WEST_STACK_ENABLED=0
GCP_WEST_REGION=us-west1
GCP_WEST_ZIXI_IP=
GCP_WEST_WEB_IP=
GCP_WEST_RELAY_IP=
GCP_WEST_RELAY_DOMAIN=
GCP_WEST_METRICS_ZONE=us-west1-a
GCP_WEST_INSTANCE_ZIXI=moq-zixi-west-gcp
GCP_WEST_INSTANCE_MEDIAMTX=moq-web-west-gcp
GCP_WEST_INSTANCE_MOQX=moq-relay-west-gcp
