# Server-side config for automatic VMAF (users just check a box in the UI).
# GCP ingest worker (Zixi VM — handles Zixi + MoQ relay ingest VMAF):
#   ./scripts/sync-ingest-agent-env.sh
INGEST_AGENT_TOKEN=
INGEST_RECORDING_DIR=/opt/zixi_broadcaster-linux64
INGEST_AGENT_PORT=8090

# Local publisher agent (laptop ffmpeg for true internet-acquisition tests).
# scripts/dev.sh enables this automatically. Do NOT set on the hosted web VM.
# LOCAL_PUBLISHER_ENABLED=1
# LOCAL_PUBLISHER_TOKEN=dev-local-publisher

# ---------------------------------------------------------------------------
# Endpoint preset credentials ("requires env" presets).
# These presets build their destination URL from the variables below. Leave
# blank to skip; the preset errors with a clear message if selected unset.
# Loaded by scripts/dev.sh and scripts/start-api.sh on startup.
# ---------------------------------------------------------------------------

# nanoStream Cloud SRT (preset: nanocosmos_srt_global) — Bintu stream ID.
NANO_SRT_STREAM_ID=

# Gcore SRT ingest (preset: gcore_srt) — full srt:// push URL from the portal.
GCORE_SRT_PUSH_URL=

# Ant Media Server RTMP (preset: antmedia_rtmp),
# e.g. rtmp://your-server/LiveApp/streamId
ANT_MEDIA_RTMP_URL=

# Presigned PUT upload targets (presets: minio_put, s3_presigned_put,
# r2_presigned_put) — paste the full presigned URL.
MINIO_PUT_URL=
S3_PRESIGNED_PUT_URL=
R2_PRESIGNED_PUT_URL=

# WHIP endpoint (preset: whip_env), e.g. https://host/whip/endpoint
WHIP_URL=
