+     * as a product API. */
+    {
+        const char *qlog_dir = getenv("MOQ_QLOG_DIR");
+        if (qlog_dir && qlog_dir[0] != '\0' &&
+            picoquic_set_qlog(quic, qlog_dir) != 0)
+            return -1;
+    }
     if (ep->insecure) return 0;
     return moq_picoquic_set_cert_verifier(quic, ep->ca_file);
 }
